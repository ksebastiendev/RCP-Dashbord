# Racine de l'API. Laisser vide tant que le backend n'existe pas :
# la couche service renvoie alors les donnees de simulation.
VITE_API_URL=

# Taux d'echec simule, entre 0 et 1. Mettre 0.5 pour eprouver les ecrans
# d'erreur sans toucher au code.
VITE_TAUX_ECHEC=0

# Latence simulee fixe, en millisecondes. Mettre 30000 pour observer les
# etats de chargement sans qu'ils disparaissent.
VITE_LATENCE_MS=0
